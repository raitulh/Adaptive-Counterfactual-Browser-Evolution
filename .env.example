# ACBE Environment Variables Configuration Example
# Copy this file to .env and configure your values

# -----------------------------------------------------------------------------
# LLM Reasoning Engine (Google Gemini)
# -----------------------------------------------------------------------------
# Get your free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# -----------------------------------------------------------------------------
# ACBE Backend API Server
# -----------------------------------------------------------------------------
ACBE_HOST=127.0.0.1
ACBE_PORT=8420
ACBE_DB_PATH=.acbe/acbe.db

# -----------------------------------------------------------------------------
# Next.js Frontend Configuration
# -----------------------------------------------------------------------------
# Optional in development (proxied by Next.js rewrites).
# Set to your production API domain when deploying frontend and backend on separate hosts.
NEXT_PUBLIC_API_URL=

