# AgentOS web — environment configuration. Copy to .env.local for local development.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time; never put secrets in them.

# Base URL the BROWSER uses for the AgentOS API. Must end with /api/v1.
#   /api/v1 (default, recommended): same-origin pass-through handled by src/app/api/v1/[...path]/route.ts,
#     forwarded to AGENTOS_API_ORIGIN. Session cookies stay first-party, no CORS.
#   https://api.example.com/api/v1: call the API directly. Requires the API on the same site
#     (e.g. app.example.com + api.example.com), COOKIE_DOMAIN=.example.com and CORS_ORIGINS set on the backend.
NEXT_PUBLIC_API_URL=/api/v1

# Server-side only: where the same-origin pass-through forwards /api/v1/* (read at request time,
# so one build can be deployed anywhere). Ignored when NEXT_PUBLIC_API_URL is absolute.
AGENTOS_API_ORIGIN=http://localhost:8000

# Public site URL (canonical links, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode: simulated data and simulated task execution in the browser, no backend calls.
# Clearly labelled in the UI. Never enable for a real deployment.
NEXT_PUBLIC_DEMO_MODE=false

# Product analytics provider: none | console. (Adapters for real providers plug into src/lib/analytics.)
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
