# ─────────────────────────────────────────────────────────────────────────────
# RealHuman API — environment variables. Copy to `.env` and adjust.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Serve interactive API docs at /docs.
DOCS_ENABLED=true

DATABASE_URL=postgresql+psycopg://realhuman:realhuman@localhost:5432/realhuman

# Required in production: 32+ random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keys the hashing of client IPs and encrypts webhook secrets — keep it stable.
SECRET_KEY=

# Dashboard origins allowed to call the API with cookies (comma-separated).
CORS_ORIGINS=http://localhost:3000
# Allow any site to call the public widget endpoints (without cookies).
WIDGET_CORS_ANY_ORIGIN=true

# Auth cookie. COOKIE_SECURE defaults to true in production.
COOKIE_SECURE=
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
AUTH_SESSION_TTL_HOURS=168

# Verification
VERIFICATION_SESSION_TTL_SECONDS=120
VERIFICATION_TOKEN_TTL_SECONDS=300
MAX_CHALLENGE_ATTEMPTS=3
HOLD_DURATION_MS=1100
# Project used when the widget sends no site key.
DEFAULT_SITE_KEY=

# Local demo data (never in production). Creates DEMO_EMAIL / DEMO_PASSWORD
# with a project whose site key is DEMO_SITE_KEY.
SEED_DEMO=true
DEMO_EMAIL=demo@realhuman.dev
DEMO_PASSWORD=realhuman-demo-password
DEMO_SITE_KEY=pk_test_demo_5f2c81a9e04b

# Number of reverse proxies in front of the API (trust X-Forwarded-For hops).
TRUSTED_PROXY_COUNT=0

# Rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SESSIONS_PER_MINUTE=30
RATE_LIMIT_CHALLENGES_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CONTACT_PER_HOUR=10
RATE_LIMIT_VERIFY_PER_MINUTE=600

# Network reputation (comma-separated CIDRs)
BLOCKLIST_CIDRS=
DATACENTER_CIDRS=

# Webhooks
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=6
# Allow deliveries to private/loopback addresses (local testing only).
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Background worker (webhooks, session expiry, retention)
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=5
