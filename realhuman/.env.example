# ─────────────────────────────────────────────────────────────────────────────
# RealHuman web — environment variables
# Copy to `.env.local` and adjust. Every variable here is PUBLIC (NEXT_PUBLIC_*)
# and is inlined into the client bundle at build time. Never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# Product name shown across the UI and metadata.
NEXT_PUBLIC_PRODUCT_NAME=RealHuman

# Canonical deployment URL (enables canonical links, sitemap, OG absolute URLs).
# Leave empty for local development.
NEXT_PUBLIC_SITE_URL=

# Verification backend (e.g. a FastAPI service). Used only when mode is "live".
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# "mock" = deterministic in-browser adapter (no backend required)
# "live" = HTTP adapter against NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_VERIFICATION_MODE=mock

# Enable the interactive verification demo on the landing page.
NEXT_PUBLIC_ENABLE_DEMO=true

# Enable the WebGL hero visual. When false, the static SVG visual is used.
NEXT_PUBLIC_ENABLE_3D=true

# Optional public repository URL. The footer shows a GitHub link only if set.
NEXT_PUBLIC_GITHUB_URL=
