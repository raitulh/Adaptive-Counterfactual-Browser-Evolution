# =============================================================================
# AgentOS backend configuration (copy to .env and edit).
#
#   cp .env.example .env
#
# Every setting in app/core/config.py is listed here with a safe default.
# Rules for this file (it is read by pydantic-settings AND by Docker Compose):
#   * one VAR=value per line, no quotes, no inline comments;
#   * list values are comma separated (a,b,c);
#   * optional settings that default to "unset" are left COMMENTED OUT — an empty
#     value is not the same as unset (e.g. WORKER_METRICS_PORT= fails to parse);
#   * secrets are EMPTY here. Never commit a real value. In staging/production they
#     come from a secret manager (see deploy/k8s/secret.example.yaml).
# The process refuses to start when critical settings are unsafe for APP_ENV
# (Settings.validate_for_startup).
# =============================================================================

# ----------------------------------------------------------------------------- application
# development | test | staging | production  (staging/production enable strict validation)
APP_ENV=development
APP_NAME=AgentOS
APP_VERSION=0.1.0
# Must be false in staging/production.
DEBUG=false
API_PREFIX=/api/v1
# Region label recorded on data (groundwork for residency / regional routing).
APP_REGION=local
PUBLIC_BASE_URL=http://localhost:8000
# Browser origins allowed by CORS (no '*' in staging/production).
CORS_ORIGINS=http://localhost:3000
# Host header allowlist; '*' disables the check (set real hostnames in production).
TRUSTED_HOSTS=*
# Maximum JSON request body (bytes); file uploads use FILE_MAX_UPLOAD_BYTES.
MAX_REQUEST_BODY_BYTES=2097152
# Serve /docs, /redoc and {API_PREFIX}/openapi.json.
EXPOSE_OPENAPI=true

# ----------------------------------------------------------------------------- database (PostgreSQL 16 + pgvector)
# Must use the asyncpg driver. Docker Compose overrides the host with `postgres`.
# For managed PostgreSQL over TLS append ?ssl=require
DATABASE_URL=postgresql+asyncpg://agentos:agentos@localhost:5432/agentos
# Per process: pool_size + max_overflow connections at most.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10.0
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_CONNECT_TIMEOUT_SECONDS=5.0
DATABASE_ECHO=false

# ----------------------------------------------------------------------------- redis (transient state only)
# Docker Compose overrides the host with `redis`. TLS: rediss://:<password>@host:6378/0?ssl_ca_certs=/path/ca.pem
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
REDIS_CONNECT_TIMEOUT_SECONDS=2.0

# ----------------------------------------------------------------------------- auth / sessions
# REQUIRED, at least 32 characters. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# If left empty the app refuses to start; the built-in default is rejected in staging/production.
JWT_SECRET=
# During JWT_SECRET rotation: old secret(s), comma separated, accepted for verification only.
JWT_PREVIOUS_SECRETS=
JWT_ALGORITHM=HS256
JWT_ISSUER=agentos
JWT_AUDIENCE=agentos-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_IDLE_TIMEOUT_SECONDS=1209600
# Lifetime of the short-lived SSE stream tokens (POST /auth/stream-token).
STREAM_TOKEN_TTL_SECONDS=120
# Must be true in staging/production (HTTPS only cookies).
COOKIE_SECURE=false
# COOKIE_DOMAIN=example.com
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
PASSWORD_MIN_LENGTH=10

# ----------------------------------------------------------------------------- encryption of stored credentials
# REQUIRED Fernet key protecting OAuth tokens, MFA secrets and MCP/tool credentials. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# During rotation: the OLD key(s), comma separated. New data is encrypted with
# TOKEN_ENCRYPTION_KEY; all listed keys can decrypt (see docs/operations.md).
TOKEN_ENCRYPTION_PREVIOUS_KEYS=
# Only `local` (Fernet keys above) is implemented in this build; `gcp`/`aws` refuse to start.
KMS_PROVIDER=local
# KMS_KEY_ID=projects/<project>/locations/<region>/keyRings/<ring>/cryptoKeys/<key>

# ----------------------------------------------------------------------------- model gateway (Gemini)
# gemini | scripted  (scripted is for tests/offline evaluation and is refused in staging/production)
MODEL_PROVIDER=gemini
# Required in staging/production. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_USE_JSON_SCHEMA=true
# Must match the vector column dimension created by the migrations (1..2000).
EMBEDDING_DIMENSIONS=768
MODEL_TIMEOUT_SECONDS=60.0
MODEL_MAX_RETRIES=2
MODEL_MAX_OUTPUT_TOKENS=8192

# ----------------------------------------------------------------------------- Google OAuth (sign-in + Gmail/Calendar/Drive/Contacts)
# From Google Cloud Console > APIs & Services > Credentials (see docs/integrations.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Both redirect URIs must be registered EXACTLY on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
GOOGLE_API_TIMEOUT_SECONDS=20.0
OAUTH_STATE_TTL_SECONDS=600
# Where the browser is sent after connecting an account.
FRONTEND_OAUTH_SUCCESS_URL=http://localhost:3000/integrations?status=connected
FRONTEND_OAUTH_ERROR_URL=http://localhost:3000/integrations?status=error

# ----------------------------------------------------------------------------- object storage
# local (development only, not durable) | s3 (S3, GCS interoperability, MinIO)
OBJECT_STORAGE_BACKEND=local
# S3-compatible endpoint; leave commented for AWS S3. MinIO profile: http://minio:9000
# GCS (HMAC keys): https://storage.googleapis.com
# OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=agentos
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1
LOCAL_STORAGE_PATH=.data/objects
SIGNED_URL_TTL_SECONDS=300
FILE_MAX_UPLOAD_BYTES=26214400
# none | clamav
MALWARE_SCANNER=none
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ----------------------------------------------------------------------------- rate limiting (Redis)
RATE_LIMIT_ENABLED=true
# true: allow requests when Redis is unreachable (outage is visible in metrics).
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_IP_PER_MINUTE=300
RATE_LIMIT_USER_PER_MINUTE=240
RATE_LIMIT_TENANT_PER_MINUTE=1200
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_TASK_CREATE_PER_MINUTE=20
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_MODEL_CALLS_PER_MINUTE=120
RATE_LIMIT_TOOL_CALLS_PER_MINUTE=240
RATE_LIMIT_BROWSER_LAUNCH_PER_MINUTE=10
RATE_LIMIT_AUTOMATION_CREATE_PER_HOUR=30

# ----------------------------------------------------------------------------- browser worker (Playwright)
BROWSER_ENABLED=true
BROWSER_HEADLESS=true
BROWSER_MAX_CONCURRENCY=2
BROWSER_TASK_TIMEOUT_SECONDS=120
BROWSER_ACTION_TIMEOUT_MS=15000
BROWSER_MAX_ACTIONS=40
# Deployment-wide domain allow/deny lists (comma separated; empty = no extra restriction).
BROWSER_ALLOWED_DOMAINS=
BROWSER_DENIED_DOMAINS=
BROWSER_ALLOW_DOWNLOADS=false
# BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
# Read by agentos-browser-worker (not by Settings): 1 disables Chromium's own sandbox. Use only
# inside an equivalently isolated container (see docs/integrations.md, browser worker).
# BROWSER_NO_SANDBOX=0

# ----------------------------------------------------------------------------- queue / workers / scheduler
QUEUE_BACKEND=postgres
# Concurrent jobs per worker process.
WORKER_CONCURRENCY=8
WORKER_POLL_INTERVAL_SECONDS=0.5
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=5
WORKER_SHUTDOWN_GRACE_SECONDS=30
SCHEDULER_INTERVAL_SECONDS=5.0
# Queues consumed by `agentos-worker` when --queues is not given (read by the worker CLI).
# `evaluation` is deliberately absent: it needs a dedicated worker (--queues evaluation), and
# `browser` is served by agentos-browser-worker.
WORKER_QUEUES=planning,execution,memory,notifications,files,maintenance

# ----------------------------------------------------------------------------- task limits
MAX_PLAN_STEPS=20
MAX_TOOL_CALLS_PER_TASK=60
MAX_MODEL_CALLS_PER_TASK=30
MAX_BROWSER_ACTIONS_PER_TASK=80
MAX_TASK_DURATION_SECONDS=21600
MAX_TASK_COST_USD=2.0
MAX_REPLANS_PER_TASK=2
MAX_PLAN_REPAIR_ATTEMPTS=2
MAX_CONCURRENT_TASKS_PER_USER=10
# How long a pending approval stays valid, and how long after approval it may be executed.
APPROVAL_TTL_SECONDS=86400
APPROVAL_EXECUTION_WINDOW_SECONDS=3600

# ----------------------------------------------------------------------------- web search
# none | brave | google_cse
SEARCH_PROVIDER=none
SEARCH_API_KEY=
GOOGLE_CSE_ID=
SEARCH_TIMEOUT_SECONDS=15.0

# ----------------------------------------------------------------------------- outbound network / SSRF
# Must be false in staging/production. true lets tools reach private addresses (local testing only).
ALLOW_PRIVATE_NETWORK_EGRESS=false
OUTBOUND_HTTP_TIMEOUT_SECONDS=20.0
OUTBOUND_MAX_RESPONSE_BYTES=5242880

# ----------------------------------------------------------------------------- MCP gateway
MCP_ENABLED=true
MCP_CALL_TIMEOUT_SECONDS=30.0
# Private hosts admins may register as MCP servers (e.g. 127.0.0.1 for scripts/demo_mcp_server.py).
# Cloud metadata endpoints are always refused.
MCP_ALLOWED_HOSTS=

# ----------------------------------------------------------------------------- e-mail notifications (optional)
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USERNAME=agentos
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=no-reply@agentos.example.com

# ----------------------------------------------------------------------------- inbound webhooks
# HMAC-SHA256 signing secret. Generate: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SIGNING_SECRET=
WEBHOOK_TOLERANCE_SECONDS=300

# ----------------------------------------------------------------------------- observability
LOG_LEVEL=INFO
LOG_JSON=true
# Traces are exported only when enabled AND an endpoint is set (install the `otlp` extra).
# The value is the FULL OTLP/HTTP traces URL, e.g. http://otel-collector:4318/v1/traces
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=agentos-backend
METRICS_ENABLED=true
# false (default): a Redis outage shows in /ready as "degraded" but keeps API pods in load balancing.
READINESS_REQUIRES_REDIS=false
# When set, GET /metrics requires `Authorization: Bearer <token>`.
METRICS_BEARER_TOKEN=
# Worker processes serve Prometheus metrics on this port when set.
# WORKER_METRICS_PORT=9100
# Error reporting (install the `sentry` extra; falls back to logs otherwise).
SENTRY_DSN=

# ----------------------------------------------------------------------------- billing
# Only `none` is implemented (usage is metered; no payment provider).
BILLING_PROVIDER=none
# free | pro | team | enterprise — plan given to new organizations.
DEFAULT_PLAN=free

# ----------------------------------------------------------------------------- data retention (days)
RETENTION_TASK_EVENTS_DAYS=180
RETENTION_EXECUTION_LOGS_DAYS=90
RETENTION_AUDIT_DAYS=730
RETENTION_USAGE_EVENTS_DAYS=400
RETENTION_NOTIFICATIONS_DAYS=90
RETENTION_TEMP_FILES_DAYS=7
RETENTION_BROWSER_ARTIFACTS_DAYS=7
RETENTION_DELETED_MEMORY_DAYS=30

# ----------------------------------------------------------------------------- server / proxy (read by uvicorn, not by Settings)
# Addresses allowed to set X-Forwarded-For/Proto (IPs or CIDRs). Only used when the
# --forwarded-allow-ips flag is not passed (the Kubernetes manifests rely on this).
# FORWARDED_ALLOW_IPS=127.0.0.1

# ----------------------------------------------------------------------------- docker compose only
# Local development credentials for the Compose postgres container (bound to 127.0.0.1).
POSTGRES_USER=agentos
POSTGRES_PASSWORD=agentos
POSTGRES_DB=agentos
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z

# ----------------------------------------------------------------------------- tests (read by tests/conftest.py)
# TEST_DATABASE_URL=postgresql+asyncpg://agentos:agentos@localhost:5432/agentos_test
# TEST_REDIS_URL=redis://localhost:6379/15
# alembic (default) builds the test schema from migrations; create_all uses the ORM metadata.
# TEST_SCHEMA_MODE=alembic
